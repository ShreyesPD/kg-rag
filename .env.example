# Environment variables for KG-RAG Medical Chatbot
# Copy this file to .env and fill in your actual values

# OpenAI API Key (required for GPT responses)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: GPT API configuration
# GPT_API_TYPE=openai  # or 'azure'
# AZURE_OPENAI_API_KEY=your_azure_key_here  # if using Azure
# AZURE_OPENAI_ENDPOINT=your_azure_endpoint_here  # if using Azure
# AZURE_OPENAI_API_VERSION=2023-12-01-preview  # if using Azure

# Flask environment (development/production)
FLASK_ENV=production
